// Zadania VS Code: Terminal → Run Task…  (albo Cmd/Ctrl+Shift+P → "Tasks: Run Task")
// Każde zadanie ma dwie wersje komendy: domyślną (macOS/Linux) i "windows" — VS Code wybiera sam.
// Skrót: "Przed PR" jest domyślnym zadaniem testowym → Cmd/Ctrl+Shift+P → "Tasks: Run Test Task".
{
  "version": "2.0.0",
  "options": { "cwd": "${workspaceFolder}" },
  "tasks": [
    {
      "label": "✅ Przed PR: pytest + ruff + F1",
      "detail": "Uruchamia po kolei testy, linter i ewaluację F1 (z porównaniem do baseline). Zatrzymuje się na pierwszym błędzie.",
      "dependsOn": ["pytest", "ruff: check", "Eval: F1 (60 spraw)"],
      "dependsOrder": "sequence",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "pytest",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "pytest", "-q"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "ruff: check",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "ruff", "check", "."],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "ruff: fix + format",
      "detail": "Automatycznie poprawia to, co się da, i formatuje kod.",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-c", "import subprocess, sys; subprocess.run([sys.executable, '-m', 'ruff', 'check', '.', '--fix']); sys.exit(subprocess.run([sys.executable, '-m', 'ruff', 'format', '.']).returncode)"],
      "problemMatcher": []
    },
    {
      "label": "Eval: F1 (60 spraw)",
      "detail": "Przetwarza 60 spraw treningowych, liczy F1 po polach i pokazuje 'F1 przed → po' względem baseline.",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "evaluation.run_eval"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Eval: skany organizatora (OCR, kilka minut)",
      "detail": "30 prawdziwych skanów z dane/skany — główny pomiar jakości OCR.",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "evaluation.run_eval", "--subset", "scans"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Eval: zapisz baseline (uruchom na master)",
      "detail": "Zapisuje wynik jako punkt odniesienia (runs/baseline_report.json). Rób to na świeżym master przed rozpoczęciem pracy.",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "evaluation.run_eval", "--save-baseline"],
      "problemMatcher": []
    },
    {
      "label": "Uruchom: input → output",
      "detail": "To samo co start.sh / start.bat — przetwarza ./input do ./output.",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "odwolania2json", "run", "--input", "input", "--output", "output"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Web UI (http://localhost:8000)",
      "detail": "Panel webowy. Zatrzymanie: kosz w terminalu albo Ctrl+C.",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "odwolania2json", "web"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Dane UZP: pobierz + 3 sprawy do input",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["scripts/fetch_data.py", "--sample-input", "3"],
      "problemMatcher": []
    },
    {
      "label": "Setup: .venv + zależności",
      "detail": "Pierwsze uruchomienie: tworzy .venv (Python 3.13) i instaluje requirements.",
      "type": "shell",
      "command": "./setup.sh",
      "windows": { "command": ".\\setup.bat" },
      "problemMatcher": []
    }
  ]
}

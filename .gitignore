# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Środowiska / sekrety ---
.venv/
venv/
env/
.env
.env.*
!.env.example

# --- Dane i artefakty uruchomień (nie commitujemy) ---
data/
runs/
traces/
.cache/

# Foldery wymagane przez organizatora — commitujemy tylko .gitkeep
input/*
!input/.gitkeep
output/*
!output/.gitkeep

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
# VS Code: wspólne zadania i rekomendowane rozszerzenia commitujemy, resztę (prywatne ustawienia) nie
.vscode/*
!.vscode/tasks.json
!.vscode/extensions.json
*.swp
*.log


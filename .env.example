# Skopiuj do .env i uzupełnij:  cp .env.example .env   (Windows: copy .env.example .env)
# Plik .env NIE trafia do repozytorium (jest w .gitignore) — klucz API trzymamy tylko tutaj.

# ---------------------------------------------------------------------------
# LLM — dowolne API zgodne z OpenAI, serwujące model OPEN-SOURCE (open weights)
# ---------------------------------------------------------------------------
# Wariant A (rozwój lokalny): Ollama na własnym komputerze
#   ollama pull qwen3.5:9b   (ten sam model co Qwen3.5-9B w OVHcloud)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:9b
# Ollama: wyłącza „myślenie” modeli Qwen3.x (bez tego model zużywa limit tokenów na rozumowanie)
LLM_EXTRA_BODY={"reasoning_effort": "none"}

# Wariant B (zgłoszenie konkursowe — wymóg organizatora: API z serwerami w UE/EOG + nasz klucz):
#   OVHcloud AI Endpoints (Francja), modele open-weights, API zgodne z OpenAI
# LLM_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# LLM_API_KEY=<klucz z panelu OVHcloud: Public Cloud → AI Endpoints → API keys>
# LLM_MODEL=Olala-v1.0-mini-7A1B      # 6,8B (≤8B → maks. punktów za wielkość modelu), Apache 2.0, bezpłatny
# Uwaga: OVHcloud odrzuca dodatkowe pola (chat_template_kwargs) i nie pozwala wyłączyć „myślenia” —
# modele rozumujące potrzebują większego limitu tokenów (llm.max_tokens w config/settings.yaml).

# Dodatkowe pola żądania (zależne od serwera), JSON — np. wyłączenie „myślenia” modeli Qwen3.x:
#   Ollama:                 LLM_EXTRA_BODY={"reasoning_effort": "none"}
#   vLLM (własny serwer):   LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
#   OVHcloud:               nie obsługuje (odrzuca dodatkowe pola)
# LLM_PROMPT_SUFFIX=/no_think

# ---------------------------------------------------------------------------
# Potok przetwarzania (nadpisuje config/settings.yaml)
# ---------------------------------------------------------------------------
# rules  — tylko reguły (bez LLM, działa offline)
# llm    — tylko LLM
# hybrid — reguły + LLM + weryfikacja (domyślnie)
# Domyślnie reguły (najlepszy zmierzony wynik, bez LLM i bez klucza API). hybrid/llm — opcjonalnie.
EXTRACTION_MODE=rules

# Ile dokumentów przetwarzać równolegle (wywołania LLM czekają na sieć)
# PIPELINE_WORKERS=4

# OCR dla skanów: auto | rapidocr | easyocr | tesseract | none
OCR_ENGINE=auto
# Windows: ścieżka do tesseract.exe, jeśli nie ma go w PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

LOG_LEVEL=INFO

# Skopiuj do .env i uzupełnij:  cp .env.example .env   (Windows: copy .env.example .env)
# Plik .env NIE trafia do repozytorium.

# ---------------------------------------------------------------------------
# LLM — dowolne API zgodne z OpenAI, serwujące model OPEN-SOURCE (open weights)
# ---------------------------------------------------------------------------
# Lokalnie (Ollama):        LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama   LLM_MODEL=qwen3:8b
# vLLM / llama.cpp server:  LLM_BASE_URL=http://<host>:8000/v1
# Hostowane open-weights:   np. Groq / Cerebras / OpenRouter (sprawdź aktualną ofertę i modele)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b

# ---------------------------------------------------------------------------
# Potok przetwarzania (nadpisuje config/settings.yaml)
# ---------------------------------------------------------------------------
# rules  — tylko reguły (bez LLM, działa offline)
# llm    — tylko LLM
# hybrid — reguły + LLM + weryfikacja (domyślnie)
EXTRACTION_MODE=hybrid

# OCR dla skanów: auto | tesseract | rapidocr | none
OCR_ENGINE=auto
# Windows: ścieżka do tesseract.exe, jeśli nie ma go w PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

LOG_LEVEL=INFO
